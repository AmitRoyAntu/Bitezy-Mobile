# Port for AI Service
PORT=8001

# MongoDB Connection (matches backend database name)
MONGODB_URI=mongodb://127.0.0.1:27017/bitezy
MONGODB_DB_NAME=bitezy

# LLM Configuration (Grok / Groq / OpenAI-compatible)
# For xAI Grok: set GROK_API_KEY=xai-... and MODEL_NAME=grok-beta or grok-2
GROK_API_KEY=

# For Groq fast inference: set GROQ_API_KEY=gsk_... and MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_KEY=

# Custom Base URL & Model (if using custom proxy)
BASE_URL=https://api.justwoker.icu
JUSTWORKER_API_KEY=
MODEL_NAME=claude-opus-4-8

